<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cybernetic Project Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes spin-slow {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .gear-spin { animation: spin-slow 12s linear infinite; }
    .hud-border {
      border: 1px solid rgba(59, 130, 246, 0.4);
      box-shadow: 0 0 15px rgba(37, 99, 235, 0.2), inset 0 0 15px rgba(37, 99, 235, 0.1);
    }
    .hud-border:hover {
      border-color: rgba(96, 165, 250, 0.8);
      box-shadow: 0 0 25px rgba(59, 130, 246, 0.4);
    }
  </style>
</head>
<body class="bg-slate-950 text-blue-100 font-mono min-h-screen p-6">
  <!-- HUD Header -->
  <header class="max-w-6xl mx-auto mb-8 p-6 hud-border rounded-xl bg-slate-900/80 backdrop-blur-md flex flex-wrap justify-between items-center gap-4">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-full border-2 border-blue-500 flex items-center justify-center bg-blue-950/50">
        <svg class="w-7 h-7 text-blue-400 gear-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
      </div>
      <div>
        <h1 class="text-2xl font-bold tracking-widest text-blue-400 uppercase">System Core // Project Hub</h1>
        <p class="text-xs text-blue-300/70">STATUS: ONLINE | SECURITY LEVEL 4</p>
      </div>
    </div>
    <div class="text-right text-xs text-blue-400">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-2"></span>3 REPOSITORIES LOADED
    </div>
  </header>

  <!-- Project Grid -->
  <main class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <div class="hud-border bg-slate-900/60 p-5 rounded-lg hover:-translate-y-1 transition-all">
      <div class="flex justify-between items-start mb-3">
        <span class="text-xs px-2 py-0.5 rounded bg-blue-900/80 text-blue-300 border border-blue-500/30">WEB APP</span>
        <span class="text-xs text-blue-400/60">#PRJ-01</span>
      </div>
      <h2 class="text-lg font-bold text-blue-200 mb-2">Malas Al Shyf Portal</h2>
      <p class="text-xs text-slate-400 mb-4">Custom restaurant digital ecosystem with dynamic menu showcase and high-performance layout.</p>
      <div class="flex gap-2 flex-wrap">
        <span class="text-[10px] bg-slate-800 text-blue-300 px-2 py-1 rounded">Lovable AI</span>
        <span class="text-[10px] bg-slate-800 text-blue-300 px-2 py-1 rounded">Tailwind</span>
      </div>
    </div>
  </main>
</body>
</html>
